# Environment Configuration for IBHAR Live Monitoring Backend
 
DJANGO_SECRET_KEY=django-insecure-default-key-change-it-in-production
DEBUG=True

# Comma-separated hostnames Django will serve. In Cloud Run this is your
# service URL host, e.g. ibhar-backend-xxxxx.a.run.app (the .run.app suffix
# is already allowed by default in settings.py).
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed if you POST/PUT via the Django admin or session-authenticated
# endpoints from the Cloud Run frontend origin.
CSRF_TRUSTED_ORIGINS=https://ibhar-frontend-xxxxx.a.run.app

# Database Settings (Local SQLite). Set DB_ENGINE=postgresql and the DB_*
# vars below to use Cloud SQL / a managed Postgres instead.
DB_ENGINE=sqlite
# --- Supabase (PostgreSQL) ---
# DATABASE_URL points ONLY the alert_store app (table live_alerts) at Supabase.
# The rest of the backend keeps using DB_ENGINE (sqlite by default).
# Use the Session pooler URL (IPv4, port 5432), NOT the transaction pooler (6543)
# and not db.<ref>.supabase.co (IPv6-only). URL-encode special chars in the password.
# DATABASE_URL=postgresql://postgres.aetoarjmjgrsxytonybj:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SCHEMA=Ibhar_Live_Monitor
# DB_SSLMODE=require
# SUPABASE_URL=https://aetoarjmjgrsxytonybj.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key - backend only, never commit>

# CORS Allowed Origins - add your Cloud Run frontend URL here
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live Hospital Telemetry External REST API Configuration
LIVE_SYNC_API_URL=https://ibharcloud.com/AzureChatBotWebApi1/api/Authentication/GetDataSyncDetails?HospitalCode=&Code=
LIVE_SYNC_USER_CODE=
LIVE_SYNC_HOSPITAL_CODES=
LIVE_SYNC_EXPECTED_INTERVAL_MINUTES=30

